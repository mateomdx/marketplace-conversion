<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        R4 — Pills horizontales ESTÁTICAS de subcategorías sobre la grilla.

        Se insertan dentro de #o_wsale_products_header, que está en
        `website_sale.products` PERO fuera de #o_wsale_products_grid. Es lo
        que importa: website_sale_infinite_scrolling re-renderiza esa
        plantilla y extrae únicamente #o_wsale_products_grid
        (website_sale_infinite_scrolling/controllers/main.py:44), así que el
        scroll infinito NO duplica las pills en cada página cargada.

        Se usa `keep()` para conservar search / filtros / orden al navegar.
    -->
    <template id="mkt_conv_category_pills" inherit_id="website_sale.products"
              name="Pills de subcategorías sobre la grilla">
        <xpath expr="//header[@id='o_wsale_products_header']" position="inside">
            <t t-set="mkt_conv_pills"
               t-value="website._mkt_conv_pill_categories(category)"/>
            <nav t-if="mkt_conv_pills" class="o_mkt_conv_pills"
                 aria-label="Subcategorías">
                <a t-foreach="mkt_conv_pills" t-as="mkt_pill"
                   t-att-href="keep(mkt_pill['url'], page=0)"
                   class="o_mkt_conv_pill"
                   t-out="mkt_pill['name']"/>
            </nav>
        </xpath>
    </template>

    <!--
        El selector de orden lee `website.shop_default_sort` para saber qué
        mostrar como activo (website_sale/views/templates.xml:967 y :981).
        Como el default de este módulo NO se guarda ahí -se resuelve en el
        controlador, para no escribir un campo de website_sale (restricción
        6)-, sin esto la tienda ordena por "Más vendidos" mientras el
        selector dice "Destacado". Se sustituye solo el valor por defecto:
        si el visitante eligió un orden, manda el suyo.
    -->
    <template id="mkt_conv_sort_label" inherit_id="website_sale.sort"
              name="Selector de orden: reflejar el default del módulo">
        <xpath expr="//t[@t-set='_current_sort']" position="before">
            <t t-set="mkt_conv_default_sort"
               t-value="'sales_velocity desc' if website.mkt_conv_sort_by_velocity else website.shop_default_sort"/>
        </xpath>
        <xpath expr="//t[@t-set='_current_sort']" position="attributes">
            <attribute name="t-value">isSortingBy and isSortingBy[0][0] or mkt_conv_default_sort</attribute>
        </xpath>
        <xpath expr="//span[@t-out=&quot;dict(website_sale_sortable)[website.shop_default_sort]&quot;]"
               position="attributes">
            <attribute name="t-out">dict(website_sale_sortable)[mkt_conv_default_sort]</attribute>
        </xpath>
    </template>
</odoo>
